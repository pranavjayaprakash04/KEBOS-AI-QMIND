# Production Environment Configuration for CTP
# Copy this to .env for production deployment

# =============================================================================
# SECURITY CONFIGURATION (CRITICAL - CHANGE ALL DEFAULTS)
# =============================================================================

# Application Security
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_SECRET_KEY_IN_PRODUCTION
JWT_SECRET_KEY=CHANGE_THIS_TO_A_DIFFERENT_STRONG_SECRET_KEY

# Database Security
POSTGRES_USER=ctp_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=ctp_production

# Redis Security
REDIS_PASSWORD=CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD

# =============================================================================
# NETWORK & CORS CONFIGURATION
# =============================================================================

# Frontend URLs (update with your actual domain)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
REACT_APP_API_URL=https://api.yourdomain.com
REACT_APP_WS_URL=wss://api.yourdomain.com

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Performance
UVICORN_WORKERS=4
CELERY_WORKERS=4

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_RAW_PACKETS_TOPIC=raw_packets
KAFKA_SIEM_EVENTS_TOPIC=siem_events
KAFKA_THREAT_ALERTS_TOPIC=threat_alerts

# =============================================================================
# AI/ML CONFIGURATION
# =============================================================================

# LLM Service
LLM_API_ENDPOINT=http://ollama:11434
THREAT_DETECTION_THRESHOLD=0.7

# Model paths (will be mounted as volumes)
MODEL_PATH=/app/models
AUTOENCODER_MODEL_PATH=/app/models/autoencoder

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Health check intervals
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=true
MONITORING_ENABLED=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

ENABLE_CORS=true
ENABLE_RATE_LIMITING=true
ENABLE_MTLS=false
ENABLE_AUDIT_LOGGING=true
ENABLE_REAL_TIME_THREATS=true
