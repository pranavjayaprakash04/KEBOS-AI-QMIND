# =============================================================================
# CTP Platform Environment Configuration - Development
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Settings
POSTGRES_USER=ctp_user
POSTGRES_PASSWORD=secure_ctp_password_2024
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ctp_database

# Database Connection String
DATABASE_URL=postgresql://ctp_user:secure_ctp_password_2024@localhost:5432/ctp_database

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Security Settings
SECRET_KEY=ctp-production-secret-key-2024-secure-token-change-this
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================

# Celery Broker and Backend
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# MLflow Configuration
# =============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# API Configuration  
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_MESSAGING=true
VITE_ENABLE_THREAT_DETECTION=true

# =============================================================================
# Ollama Configuration (for GenAI features)
# =============================================================================
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# =============================================================================
# Application URLs
# =============================================================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
