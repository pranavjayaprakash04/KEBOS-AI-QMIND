{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start CTP Backend (FastAPI)",
      "type": "shell",
      "command": "uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
      "group": "build",
      "problemMatcher": [],
      "options": {
        "cwd": "backend"
      }
    },
    {
      "label": "Start CTP Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "group": "build",
      "problemMatcher": [],
      "options": {
        "cwd": "frontend"
      }
    },
    {
      "label": "Start Celery Worker",
      "type": "shell",
      "command": "celery -A main.celery_app worker --loglevel=info",
      "group": "build",
      "problemMatcher": [],
      "options": {
        "cwd": "backend"
      }
    },
    {
      "label": "Start Kafka Services",
      "type": "shell",
      "command": "docker-compose -f docker-compose.ctp.yml up -d zookeeper kafka kafka-ui",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Start CTP Full Stack",
      "type": "shell",
      "command": "docker-compose -f docker-compose.ctp.yml up -d",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Stop CTP Services",
      "type": "shell",
      "command": "docker-compose -f docker-compose.ctp.yml down",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
