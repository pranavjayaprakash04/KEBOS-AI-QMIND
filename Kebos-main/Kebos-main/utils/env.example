# =============================================================================
# CTP Platform Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# cp env.example .env

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Settings
POSTGRES_USER=ctp_user
POSTGRES_PASSWORD=your_secure_password_here_change_this
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ctp_database

# Database Connection String (auto-generated)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Security Settings
SECRET_KEY=your-super-secret-key-here-change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=your_redis_password_here

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================

# Celery Broker and Backend
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Celery Settings
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# =============================================================================
# MLFLOW CONFIGURATION
# =============================================================================

# MLflow Tracking
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_TRACKING_USERNAME=mlflow_user
MLFLOW_TRACKING_PASSWORD=mlflow_password

# MLflow Settings
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
MLFLOW_EXPERIMENT_NAME=default

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS Settings
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# File Upload Settings
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=.pkl,.joblib,.h5,.onnx,.pb,.pt,.pth,.safetensors
UPLOAD_PATH=./uploaded_models

# =============================================================================
# MODEL STORAGE CONFIGURATION
# =============================================================================

# Storage Paths
MODEL_STORAGE_PATH=./uploaded_models
ARTIFACT_STORAGE_PATH=./artifacts
LOG_STORAGE_PATH=./logs

# Storage Settings
ENABLE_MODEL_VERSIONING=true
MAX_MODEL_SIZE=2GB
MODEL_CLEANUP_DAYS=30

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Logging Settings
LOG_FORMAT=json
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# Audit Logging
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_FILE=./logs/audit.log

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Health Check Settings
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Metrics Settings
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# React App Settings
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=production
REACT_APP_VERSION=1.0.0

# Frontend Build Settings
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false

# =============================================================================
# OLLAMA CONFIGURATION (Optional)
# =============================================================================

# Ollama Settings
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=300

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TLS=true

# Email Settings
FROM_EMAIL=noreply@ctp.com
ADMIN_EMAIL=admin@ctp.com

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# AWS S3 (for model storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ctp-models

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key
AZURE_CONTAINER_NAME=ctp-models

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_BUCKET=ctp-models

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development Mode (set to true for development)
DEV_MODE=false
HOT_RELOAD=false
DEBUG_TOOLBAR=false

# Development Tools
PGADMIN_EMAIL=admin@ctp.dev
PGADMIN_PASSWORD=admin

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# Production Security
ENABLE_SSL=false
SSL_CERT_PATH=/etc/nginx/ssl/nginx.crt
SSL_KEY_PATH=/etc/nginx/ssl/nginx.key

# Production Performance
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1024
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Settings
ENABLE_AUTO_BACKUP=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#ctp-alerts

# Discord Notifications (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Cache Settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Session Settings
SESSION_SECRET=your-session-secret-key
SESSION_TIMEOUT=3600

# API Settings
API_VERSION=v1
API_PREFIX=/api
API_TITLE=CTP Platform API
API_DESCRIPTION=Cyber Threat Platform API

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/Disable Features
ENABLE_MODEL_REGISTRY=true
ENABLE_SECURITY_AUDIT=true
ENABLE_DOCUMENTATION_GENERATION=true
ENABLE_PRIVACY_ASSESSMENT=true
ENABLE_RISK_ASSESSMENT=true
ENABLE_IMPACT_ASSESSMENT=true

# =============================================================================
# INTEGRATION SETTINGS
# =============================================================================

# External API Keys (Optional)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
COHERE_API_KEY=your_cohere_api_key

# Model Validation Services
MODEL_VALIDATION_ENABLED=true
MODEL_VALIDATION_TIMEOUT=300

# =============================================================================
# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Memory Settings
MAX_MEMORY_USAGE=80
GARBAGE_COLLECTION_INTERVAL=300

# Threading Settings
MAX_THREADS=8
THREAD_POOL_SIZE=4

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================

# Deployment Environment
DEPLOYMENT_ENV=production
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_VERSION=1.0.0

# Load Balancer Settings
LOAD_BALANCER_ENABLED=false
LOAD_BALANCER_HEALTH_CHECK_PATH=/health

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
# Remember to:
# 1. Change all default passwords and keys
# 2. Use strong, unique passwords
# 3. Keep this file secure and never commit it to version control
# 4. Use different values for development, staging, and production
# 5. Regularly rotate secrets and keys 